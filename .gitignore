.env
.venv
*.gpkg
.ipynb_checkpoints
.ridge-src
__pycache__
.conda
cache

# Ignore all files in any project's output/ directory (the pattern must re-include
# subdirectories, or git never descends to see the negated files below)
**/output/**
!**/output/**/

# Allow .png files and layer documentation to be tracked
!**/output/**/*.png
!**/output/LAYERS.md
