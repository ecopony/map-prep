# Copy to .env at the repo root and point each variable at your local data archive.
# Nothing here is secret — these are filesystem locations for bulk geospatial data
# that is too large to track in git.

# Natural Earth shapefiles. Expected to contain per-theme subdirectories, e.g.
#   Countries/ne_50m_admin_0_countries/ne_50m_admin_0_countries.shp
#   StatesProvinces/ne_50m_admin_1_states_provinces_lakes/...
#   Lakes/ne_50m_lakes/ne_50m_lakes.shp
# Used by: mapprep.natural_earth (and therefore every project importing it),
#          conferences, wind-turbines
NATURAL_EARTH_DIR=C:/GIS/NaturalEarth

# NASA elevation data. Expected to contain SRTM_30/ with zipped tiles.
# Used by: forest-loss
NASA_DIR=C:/GIS/NASA

# USGS The National Map, organized by state code, e.g.
#   OR/GOVTUNIT_Oregon_State_GPKG/GOVTUNIT_Oregon_State_GPKG.gpkg
#   OR/TRAN_Oregon_State_GPKG/TRAN_Oregon_State_GPKG.gpkg
#   WA/TRAN_Washington_State_GPKG/TRAN_Washington_State_GPKG.gpkg
# Used by: stylized-pdx
TNM_DIR=C:/GIS/TNM

# USGS National Hydrography Dataset, organized by state code, e.g.
#   OR/NHD_H_Oregon_State_GDB/NHD_H_Oregon_State_GDB.gdb
# Used by: stylized-pdx
NHD_DIR=C:/GIS/NHD

# Catch-all for project-specific downloads, e.g.
#   WindTurbines/uswtdbSHP/uswtdb_v6_1_20231128.shp
#   WindTurbines/capacity/installed-capacity.csv
# Used by: wind-turbines
DATA_DIR=C:/GIS/Data
